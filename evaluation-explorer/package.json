{
  "name": "@ztd/evaluation-explorer",
  "private": true,
  "license": "BUSL-1.1",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:mock": "node dev.mjs --mode mock",
    "dev:real": "node dev.mjs --mode real",
    "seed": "node scripts/seed.mjs",
    "replay": "node scripts/replay.mjs",
    "health": "node scripts/mirror-health.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-production-dist.mjs",
    "build:production": "npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && ZTD_PUBLIC_MIRROR_ORIGIN=https://opendevops.ai playwright test --config playwright.production.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
