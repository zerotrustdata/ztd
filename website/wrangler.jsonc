{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerotrustdata",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "ztd-releases"
    }
  ],
  "routes": [
    {
      "pattern": "zerotrustdata.io",
      "custom_domain": true
    },
    {
      "pattern": "www.zerotrustdata.io",
      "custom_domain": true
    }
  ]
}
