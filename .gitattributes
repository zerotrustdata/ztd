# Default to LF for text files across the repository to ensure consistent behavior
* text=auto eol=lf

# PowerShell scripts use CRLF on Windows
*.ps1 text eol=crlf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar.gz binary
*.zip binary
*.exe binary
*.bin binary

# Ensure LF line endings for build, test, and language files
Makefile        text eol=lf
*.mk            text eol=lf
*.sh            text eol=lf
*.go            text eol=lf
*.mod           text eol=lf
*.sum           text eol=lf

# Authenticated artifacts: line-ending conversion changes the pinned bytes.
protocol/schemas/oscal/v1.1.2/*.json text eol=lf
ztd-adapter/contract-pack/** text eol=lf
evaluation-explorer/src/content/scenario-catalog.generated.ts text eol=lf
evaluation-explorer/runtime.production.json text eol=lf
