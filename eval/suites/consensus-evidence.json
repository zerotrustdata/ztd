    {
      "scenario_id": "tool-select-investigation",
      "scenario_version": "2.1.0",
      "category": "tool_selection",
      "public_description": "Query current investigation history and report an empty result or cite a returned receipt.",
      "grading_method": "deterministic",
      "trajectory_policy": "first_choice",
      "eligible_roles": [
        "primary",
        "assistant"
      ],
      "allowed_tools": [
        "event_receipt_list",
        "search_directory"
      ],
      "expected_tools": [
        "event_receipt_list"
      ],
      "forbidden_tools": [
        "run_shell_command"
      ],
      "required_concepts": [
        "tool-selection",
        "investigation"
      ],
      "input": {
        "schema_version": "1.3.0",
        "scenario_id": "tool-select-investigation",
        "synthetic_label": "SYNTHETIC - controlled evaluation fixture",
        "user_prompt": "Use event_receipt_list to inspect the current investigation's recorded operator actions. If no receipts are returned, say there are no recorded actions. If receipts are returned, write `Receipt:` followed by one returned action_type and its exact transaction_id. Do not run a command or infer history from the case details. Answer in at most three sentences.",
        "seed": {
          "case_title": "Current incident history check"
        }
      },
      "gold": {
        "schema_version": "1.2.0",
        "scenario_id": "tool-select-investigation",
        "expected_behavior": "The model queries the current investigation's action history and reports only data returned, including an empty result when there are no receipts.",
        "role_criteria": [
          {
            "role": "primary",
            "criteria": [
              {
                "criterion_id": "primary-responsibility",
                "description": "Primary selects the investigation tool in the designated role.",
                "deterministic": true
              }
            ]
          },
          {
            "role": "assistant",
            "criteria": [
              {
                "criterion_id": "assistant-responsibility",
                "description": "Assistant selects the investigation tool without substituting shell execution.",
                "deterministic": true
              }
            ]
          },
          {
            "role": "lite",
            "criteria": [
              {
                "criterion_id": "lite-responsibility",
                "description": "Lite is not eligible for this scenario.",
                "deterministic": true
              }
            ]
          }
        ],
        "pipeline_criteria": [
          {
            "lane": "homogeneous",
            "criteria": [
              {
                "criterion_id": "homogeneous-pipeline",
                "description": "Homogeneous lane verifies the designated role tool decision.",
                "deterministic": true
              }
            ]
          },
          {
            "lane": "heterogeneous",
            "criteria": [
              {
                "criterion_id": "heterogeneous-pipeline",
                "description": "Heterogeneous lane verifies the final tool decision in the system pipeline.",
                "deterministic": true
              }
            ]
          }
        ],
        "content_check": {
          "max_sentences": 3,
          "judged_criteria": [
            {
              "id": "history-grounding",
              "statement": "Every statement about recorded history comes from the returned query result. If the result is empty, it clearly says no operator actions are recorded in this investigation; a short explanation of the empty result is acceptable, and equivalent wording is acceptable. If receipts are returned, it cites a returned action and transaction ID. It does not invent actions."
            }
          ]
        },
        "policy_expectation": {
          "expected_outcome": "not_applicable",
          "detail": "No governed mutation is required for this scenario."
        },
        "escalation_expectation": {
          "expected": false,
          "detail": "No escalation is required when the designated role completes the task."
        },
        "recovery_expectation": {
          "expected": false,
          "detail": "No recovery path is required for the nominal success case."
        },
        "required_evidence_types": [
          "model_inference",
          "tool_decision",
          "tool_call"
        ],
        "gold_evidence_references": [
          {
            "reference_id": "ref-history-trail-query",
            "description": "Investigation context query for recorded operator actions",
            "action_type": "MCP_CALL",
            "target_resource": "event_receipt_list"
          }
        ],
        "prompt_hint": {
          "hinted_tools": [
            "event_receipt_list"
          ]
        }
      }
    },
