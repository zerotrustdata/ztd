            ]
          },
          {
            "lane": "heterogeneous",
            "criteria": [
              {
                "criterion_id": "heterogeneous-pipeline",
                "description": "Heterogeneous lane verifies the final tool decision in the system pipeline.",
                "deterministic": true
              }
            ]
          }
        ],
        "content_check": {
          "max_sentences": 3,
          "judged_criteria": [
            {
              "id": "history-grounding",
