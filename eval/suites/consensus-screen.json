                "deterministic": true
              }
            ]
          },
          {
            "lane": "heterogeneous",
            "criteria": [
              {
                "criterion_id": "heterogeneous-pipeline",
                "description": "Heterogeneous lane verifies final contradiction detection.",
                "deterministic": true
              }
            ]
          }
