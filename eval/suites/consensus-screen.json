            "role": "lite",
            "criteria": [
              {
                "criterion_id": "lite-responsibility",
                "description": "Lite is not eligible for this scenario.",
                "deterministic": true
              }
            ]
          }
        ],
        "pipeline_criteria": [
          {
            "lane": "homogeneous",
            "criteria": [
              {
                "criterion_id": "homogeneous-pipeline",
                "description": "Homogeneous lane verifies the designated role tool decision.",
                "deterministic": true
