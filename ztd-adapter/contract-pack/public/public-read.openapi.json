{
  "components": {
    "schemas": {
      "PublicFeedBatch": {
        "$ref": "#/x-models/public_feed_batch"
      },
      "PublicFeedBootstrap": {
        "$ref": "#/x-models/public_feed_bootstrap"
      },
      "PublicFeedCursorPage": {
        "$ref": "#/x-models/public_feed_cursor_page"
      },
      "PublicFeedRecord": {
        "$ref": "#/x-models/public_feed_record"
      },
      "PublicFeedSnapshot": {
        "$ref": "#/x-models/public_feed_snapshot"
      },
      "PublicLiveStatus": {
        "$ref": "#/x-models/public_live_status"
      },
      "PublicPointer": {
        "$ref": "#/x-models/public_pointer"
      },
      "PublicProofCatalog": {
        "$ref": "#/x-models/public_proof_catalog"
      },
      "PublicProofCatalogEntry": {
        "$ref": "#/x-models/public_proof_catalog_entry"
      },
      "PublicProofCatalogSummary": {
        "$ref": "#/x-models/public_proof_catalog_summary"
      },
      "PublicProofHead": {
        "$ref": "#/x-models/public_proof_head"
      },
      "PublicProofManifest": {
        "$ref": "#/x-models/public_proof_manifest"
      },
      "PublicProofManifestSegment": {
        "$ref": "#/x-models/public_proof_manifest_segment"
      },
      "PublicProofSegmentsResponse": {
        "$ref": "#/x-models/public_proof_segments_response"
      }
    }
  },
  "info": {
    "description": "Anonymous, read-only public layout. Every path is a static object served by the bucket or its local mirror. There are no query strings, no event streams, and no mutable paths other than pointer.json and live/status.json.",
    "title": "ztd Public Spectator Read API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/history/{first_sequence}.json.gz": {
      "get": {
        "operationId": "public_history",
        "parameters": [
          {
            "description": "Chunk or page start; 1, 1001, 2001, and so on",
            "in": "path",
            "name": "first_sequence",
            "required": true,
            "schema": {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicFeedCursorPage"
                }
              }
            },
            "description": "Gzip-encoded bounded history page",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=3600"
                  ],
                  "type": "string"
                }
              },
              "Content-Encoding": {
                "schema": {
                  "enum": [
                    "gzip"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No records in the range"
          }
        }
      }
    },
    "/live/runs/{run_id}.jsonl.gz": {
      "get": {
        "operationId": "public_live_run",
        "parameters": [
          {
            "description": "A run listed in live/status.json active_runs",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/gzip": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Run bundle for an executing run. The object is gzip data served without Content-Encoding.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=60"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Run is not executing or has no result records yet"
          }
        }
      }
    },
    "/live/status.json": {
      "get": {
        "operationId": "public_live_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicLiveStatus"
                }
              }
            },
            "description": "Snapshot, executing runs, and the newest feed records",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=10"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/pointer.json": {
      "get": {
        "operationId": "public_pointer",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicPointer"
                }
              }
            },
            "description": "Signed pointer naming the current digest-addressed objects",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=30"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/proof-catalog/{proof_catalog_sha256}.json.gz": {
      "get": {
        "operationId": "public_proof_catalog",
        "parameters": [
          {
            "in": "path",
            "name": "proof_catalog_sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProofCatalog"
                }
              }
            },
            "description": "Gzip-encoded public-safe proof catalog. The SHA-256 of the decoded bytes equals the pointer proof_catalog_sha256.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=31536000, immutable"
                  ],
                  "type": "string"
                }
              },
              "Content-Encoding": {
                "schema": {
                  "enum": [
                    "gzip"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown digest"
          }
        }
      }
    },
    "/proof-head.json": {
      "get": {
        "operationId": "public_proof_head",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProofHead"
                }
              }
            },
            "description": "Constant-size proof head without artifact entries; verify the signed log for authenticity",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=30"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No proof publication for the source"
          }
        }
      }
    },
    "/proof-meta/{sha256}.json": {
      "get": {
        "operationId": "public_proof_meta",
        "parameters": [
          {
            "in": "path",
            "name": "sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProofCatalogEntry"
                }
              }
            },
            "description": "One active proof catalog entry",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=31536000, immutable"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or withdrawn artifact"
          }
        }
      }
    },
    "/proof-segments/{first_index}.jsonl.gz": {
      "get": {
        "operationId": "public_proof_segments",
        "parameters": [
          {
            "description": "Chunk or page start; 1, 1001, 2001, and so on",
            "in": "path",
            "name": "first_index",
            "required": true,
            "schema": {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProofManifestSegment"
                }
              }
            },
            "description": "Gzip-encoded JSON Lines of up to 1000 source-signed proof segments, including withdrawals. Full chunks are immutable; the last chunk uses the tail policy.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=60",
                    "public, max-age=31536000, immutable"
                  ],
                  "type": "string"
                }
              },
              "Content-Encoding": {
                "schema": {
                  "enum": [
                    "gzip"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No segments in the range"
          }
        }
      }
    },
    "/proofs/{artifact_id}": {
      "get": {
        "operationId": "public_proof_download",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Content-addressed public-safe proof bytes"
          }
        }
      }
    },
    "/read-model/{read_model_sha256}.json.gz": {
      "get": {
        "operationId": "public_read_model",
        "parameters": [
          {
            "in": "path",
            "name": "read_model_sha256",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicFeedBootstrap"
                }
              }
            },
            "description": "Gzip-encoded read model in the /bootstrap shape. The SHA-256 of the decoded bytes equals the pointer read_model_sha256.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "public, max-age=31536000, immutable"
                  ],
                  "type": "string"
                }
              },
              "Content-Encoding": {
                "schema": {
                  "enum": [
                    "gzip"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown digest"
          }
        }
      }
    }
  },
  "x-models": {
    "public_feed_batch": {
      "content_hash": {
        "description": "SHA-256 over the canonical encoding of all record hashes and batch metadata (64-char hex)",
        "required": true,
        "type": "string"
      },
      "first_sequence": {
        "description": "Monotonic sequence number of the first record in the batch",
        "required": true,
        "type": "integer"
      },
      "generated_at": {
        "description": "UTC timestamp when the batch was produced",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "last_sequence": {
        "description": "Monotonic sequence number of the last record in the batch",
        "required": true,
        "type": "integer"
      },
      "previous_batch_hash": {
        "description": "SHA-256 of the previous accepted batch. The first batch carries a fixed zero hash (64-char hex of 32 zero bytes).",
        "required": true,
        "type": "string"
      },
      "protocol_version": {
        "description": "Public feed protocol version",
        "required": true,
        "type": "string"
      },
      "record_hashes": {
        "description": "SHA-256 of each record in the batch, in order",
        "items": "string",
        "required": true,
        "type": "array"
      },
      "records": {
        "description": "Records in this batch, in sequence order",
        "items": "public_feed_record",
        "required": true,
        "type": "array"
      },
      "schema_version": {
        "description": "Projection schema version",
        "required": true,
        "type": "string"
      },
      "signature": {
        "description": "Ed25519 signature over the content hash, hex-encoded",
        "required": true,
        "type": "string"
      },
      "signing_key_id": {
        "description": "Identifier of the signing key used to produce the signature",
        "required": true,
        "type": "string"
      },
      "source_id": {
        "description": "Pseudonymous source deployment identifier. Not the real hostname, IP, or PKI identity.",
        "required": true,
        "type": "string"
      }
    },
    "public_feed_bootstrap": {
      "generated_at": {
        "description": "UTC timestamp when the bootstrap was produced",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "proof_catalog_summary": {
        "description": "Summary of the available public proof packages",
        "model": "public_proof_catalog_summary",
        "required": true,
        "type": "object"
      },
      "protocol_version": {
        "description": "Public feed protocol version",
        "required": true,
        "type": "string"
      },
      "recent_projections": {
        "description": "Bounded list of recent public projections (JSON objects). Each carries only allowlisted fields.",
        "required": true,
        "type": "array"
      },
      "snapshot": {
        "description": "Current feed snapshot with high-water sequence and feed-chain hash",
        "model": "public_feed_snapshot",
        "required": true,
        "type": "object"
      },
      "source_freshness": {
        "description": "Source freshness label",
        "enum": [
          "active",
          "delayed",
          "stale",
          "intentionally_stopped",
          "safety_stopped",
          "source_offline"
        ],
        "required": true,
        "type": "string"
      }
    },
    "public_feed_cursor_page": {
      "cursor": {
        "description": "Opaque cursor for the next page. Omitted when there are no more results.",
        "required": false,
        "type": "string"
      },
      "has_more": {
        "required": true,
        "type": "boolean"
      },
      "items": {
        "description": "Page items. Each item is a JSON object with only allowlisted fields.",
        "required": true,
        "type": "array"
      },
      "limit": {
        "description": "Page size applied to this response",
        "required": true,
        "type": "integer"
      },
      "protocol_version": {
        "description": "Public feed protocol version",
        "required": true,
        "type": "string"
      }
    },
    "public_feed_record": {
      "record_bytes": {
        "description": "Canonical JSON bytes of the record, UTF-8 encoded",
        "required": true,
        "type": "string"
      },
      "record_hash": {
        "description": "SHA-256 of the canonical record bytes (64-char hex)",
        "required": true,
        "type": "string"
      },
      "record_type": {
        "description": "Record type from the closed vocabulary",
        "enum": [
          "projection",
          "event",
          "proof_manifest",
          "key_revocation"
        ],
        "required": true,
        "type": "string"
      },
      "sequence": {
        "description": "Monotonic sequence number assigned by the source",
        "required": true,
        "type": "integer"
      }
    },
    "public_feed_snapshot": {
      "batch_count": {
        "description": "Total number of accepted batches",
        "required": true,
        "type": "integer"
      },
      "feed_chain_hash": {
        "description": "Content hash of the last accepted batch (64-char hex)",
        "required": true,
        "type": "string"
      },
      "freshness": {
        "description": "Source freshness label",
        "enum": [
          "active",
          "delayed",
          "stale",
          "intentionally_stopped",
          "safety_stopped",
          "source_offline"
        ],
        "required": true,
        "type": "string"
      },
      "generated_at": {
        "description": "UTC timestamp when the snapshot was produced",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "high_water_sequence": {
        "description": "The last accepted monotonic sequence number",
        "required": true,
        "type": "integer"
      },
      "protocol_version": {
        "description": "Public feed protocol version",
        "required": true,
        "type": "string"
      },
      "source_id": {
        "description": "Pseudonymous source deployment identifier",
        "required": true,
        "type": "string"
      },
      "withdrawal_digest": {
        "description": "SHA-256 over the mirror's sorted withdrawn dataset IDs, the zero hash when none (64-char hex). Present on every mirror read; absent from the publisher's own snapshot. Withdrawal hides records without rewriting the signed chain, so a client discards cached records when this changes.",
        "required": false,
        "type": "string"
      }
    },
    "public_live_status": {
      "description": "Live status: the snapshot, executing runs, and the newest feed records.",
      "properties": {
        "active_runs": {
          "items": {
            "properties": {
              "dataset_id": {
                "minLength": 1,
                "type": "string"
              },
              "lifecycle_state": {
                "minLength": 1,
                "type": "string"
              },
              "run_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "dataset_id",
              "run_id",
              "lifecycle_state"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/x-models/public_feed_snapshot"
        },
        "tail": {
          "description": "Newest feed records, oldest first. Assignment results arrive through live/runs.",
          "items": {
            "properties": {
              "record_bytes": {
                "description": "Canonical JSON of the record payload",
                "type": "string"
              },
              "record_type": {
                "minLength": 1,
                "type": "string"
              },
              "sequence": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "sequence",
              "record_type",
              "record_bytes"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "snapshot",
        "active_runs",
        "tail"
      ],
      "type": "object"
    },
    "public_pointer": {
      "description": "Mutable mirror pointer. It names the current digest-addressed read model and proof catalog. It is written last, so a partial publish never goes live. While a run is active the publisher holds it and moves it only when the active run set changes, a withdrawal lands, or records of a dataset that is not executing arrive; live/status.json carries the run in between. generated_at is when the pointer was composed, not a freshness signal.",
      "properties": {
        "active": {
          "description": "True while a run is executing; poll live/status.json",
          "type": "boolean"
        },
        "feed_chain_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "high_water_sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "history_first_sequence": {
          "description": "First retained sequence of the signed batch chain",
          "minimum": 0,
          "type": "integer"
        },
        "proof_catalog_sha256": {
          "description": "SHA-256 of the decoded proof catalog bytes",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "proof_root_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "proof_segment_head": {
          "minimum": 0,
          "type": "integer"
        },
        "read_model_sha256": {
          "description": "SHA-256 of the decoded read-model bytes",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision": {
          "description": "Increases with every pointer the source writes",
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "signature": {
          "description": "Ed25519 over the domain-separated digest of every other field",
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        },
        "signing_key_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "signing_public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "withdrawal_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "revision",
        "read_model_sha256",
        "proof_segment_head",
        "high_water_sequence",
        "history_first_sequence",
        "feed_chain_hash",
        "active",
        "generated_at"
      ],
      "type": "object"
    },
    "public_proof_catalog": {
      "entries": {
        "description": "Catalog entries for every available proof artifact",
        "items": "public_proof_catalog_entry",
        "required": true,
        "type": "array"
      },
      "generated_at": {
        "description": "UTC timestamp when the catalog was generated",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "schema_version": {
        "description": "Proof catalog schema version",
        "required": true,
        "type": "string"
      }
    },
    "public_proof_catalog_entry": {
      "artifact_id": {
        "description": "Content-addressed artifact identifier (derived from SHA-256)",
        "required": true,
        "type": "string"
      },
      "byte_size": {
        "description": "Byte length of the artifact content",
        "required": true,
        "type": "integer"
      },
      "campaign_id": {
        "description": "Campaign identity from the campaign manifest",
        "required": true,
        "type": "string"
      },
      "classification": {
        "description": "Disclosure classification",
        "enum": [
          "public_safe"
        ],
        "required": true,
        "type": "string"
      },
      "filename": {
        "description": "Human-readable filename",
        "required": true,
        "type": "string"
      },
      "generated_at": {
        "description": "UTC timestamp when the artifact was generated",
        "format": "iso8601",
        "required": true,
        "type": "string"
      },
      "immutable_url": {
        "description": "Immutable content-addressed URL path relative to the mirror base URL",
        "required": true,
        "type": "string"
      },
      "media_type": {
        "description": "IANA media type of the artifact content",
        "required": true,
        "type": "string"
      },
      "sha256": {
        "description": "SHA-256 of the artifact content (64-char hex)",
        "required": true,
        "type": "string"
      },
      "source_run_id": {
        "description": "Source eval run identity. Omitted for campaign-level artifacts.",
        "required": false,
        "type": "string"
      },
      "verification_command": {
        "description": "Offline verification command for this artifact",
        "required": true,
        "type": "string"
      }
    },
    "public_proof_catalog_summary": {
      "artifact_count": {
        "description": "Total number of proof artifacts in the catalog",
        "required": true,
        "type": "integer"
      },
      "last_generated_at": {
        "description": "UTC timestamp of the most recently generated proof artifact. Omitted when the catalog is empty.",
        "format": "iso8601",
        "required": false,
        "type": "string"
      },
      "total_byte_size": {
        "description": "Total byte size of all proof artifacts",
        "required": true,
        "type": "integer"
      }
    },
    "public_proof_head": {
      "artifact_count": {
